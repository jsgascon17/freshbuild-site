# freshbuild.co — clean URLs
#
# Pages are stored as about.html, services.html, locations/rochester-ny.html …
# but are served at /about, /services, /locations/rochester-ny. The .html form
# permanently redirects to the clean form so only one address is ever in circulation.
#
# Standard: github.com/jsgascon17/freshbuild-ops — ops/seo-aeo/STANDARD.md
#   SEO-SITE-6    one URL form per page, sitewide
#   SEO-SITE-4    canonical must resolve
#   SEO-SITE-5    redirects are single-hop
#   SEO-PROCESS-1 any URL change ships with a 301

RewriteEngine On

# 0. Deny the git metadata directory — must stay first, before any rewrite.
#    The deploy checkout lives in the webroot, so .git/ was being served.
#    .git/refs/heads/main gives the tip commit and .git/index lists every
#    tracked path and blob SHA, which together are enough to walk the trees and
#    download the entire source history — including files removed from the
#    webroot but still present in earlier commits (e.g. the internal docs
#    deleted in 24e6d5c). Verified exploitable before this rule was added.
RewriteRule ^\.git - [F,L]

# 1. /index.html -> /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

# 2. /anything.html -> /anything   (one hop, permanent)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 3. /anything/ -> /anything
#    Internal links are relative (../about, brighton-ny). Serving both /about and
#    /about/ would resolve those links against two different base paths and break
#    the trailing-slash version. Only the no-slash form is ever served.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# 4. Serve the .html file behind the clean URL. Internal rewrite, not a redirect —
#    the visitor's address bar keeps showing /about.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# Real 404s for anything else (rule SEO-SITE-14) — no catch-all to the homepage.
